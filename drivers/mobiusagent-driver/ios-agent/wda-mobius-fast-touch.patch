 #pragma mark - Helpers
 
+#pragma mark - Mobius fast touch
+
+static UIInterfaceOrientation FBMobiusOrientation(NSDictionary *args)
+{
+  NSString *o = args[@"orientation"];
+  if ([o isEqualToString:@"landscape_left"]) return UIInterfaceOrientationLandscapeLeft;
+  if ([o isEqualToString:@"landscape_right"]) return UIInterfaceOrientationLandscapeRight;
+  if ([o isEqualToString:@"upside_down"]) return UIInterfaceOrientationPortraitUpsideDown;
+  return UIInterfaceOrientationPortrait;
+}
+
+static id<FBResponsePayload> FBMobiusSynthesize(XCPointerEventPath *path, NSDictionary *args)
+{
+  XCSynthesizedEventRecord *record = [[XCSynthesizedEventRecord alloc] initWithName:@"Mobius touch"
+                                                               interfaceOrientation:FBMobiusOrientation(args)];
+  [record addPointerEventPath:path];
+  NSError *error;
+  if (![FBXCTestDaemonsProxy synthesizeEventWithRecord:record error:&error]) {
+    return FBResponseWithUnknownError(error);
+  }
+  return FBResponseWithOK();
+}
+
++ (id<FBResponsePayload>)handleMobiusTap:(FBRouteRequest *)request
+{
+  CGPoint p = CGPointMake([request.arguments[@"x"] doubleValue], [request.arguments[@"y"] doubleValue]);
+  double hold = request.arguments[@"hold"] ? [request.arguments[@"hold"] doubleValue] : 0.05;
+  XCPointerEventPath *path = [[XCPointerEventPath alloc] initForTouchAtPoint:p offset:0];
+  [path liftUpAtOffset:hold];
+  return FBMobiusSynthesize(path, request.arguments);
+}
+
++ (id<FBResponsePayload>)handleMobiusSwipe:(FBRouteRequest *)request
+{
+  NSDictionary *a = request.arguments;
+  double duration = a[@"duration"] ? [a[@"duration"] doubleValue] : 0.2;
+  XCPointerEventPath *path = [[XCPointerEventPath alloc] initForTouchAtPoint:CGPointMake([a[@"x1"] doubleValue], [a[@"y1"] doubleValue]) offset:0];
+  [path moveToPoint:CGPointMake([a[@"x2"] doubleValue], [a[@"y2"] doubleValue]) atOffset:duration];
+  [path liftUpAtOffset:duration + 0.01];
+  return FBMobiusSynthesize(path, a);
+}
