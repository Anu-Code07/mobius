{
  "name": "@anuraghq/mobius",
  "version": "0.1.2",
  "description": "Let AI agents use a real phone, safely. MCP server + its own fast device driver for Android, iPhones and iOS simulators: 75 tools, approvals, policy, masking, signed audit, performance and accessibility reports.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "mobius": "dist/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "ios-agent",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "android",
    "ios",
    "iphone",
    "simulator",
    "emulator",
    "mobile",
    "ai-agent",
    "agent-safety",
    "claude",
    "automation",
    "testing",
    "qa",
    "performance",
    "accessibility"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build && node scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": "github:Anu-Code07/mobius",
  "homepage": "https://github.com/Anu-Code07/mobius#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.1.0"
  }
}
